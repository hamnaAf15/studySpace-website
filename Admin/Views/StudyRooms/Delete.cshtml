@model studySpaceWebApp.Models.StudyRoom

@{
    ViewData["Title"] = "Delete";
}

<h1 class="mb-4">Delete Study Room</h1>

<div class="alert alert-warning">
    <h4 class="alert-heading">Are you sure you want to delete this room?</h4>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-danger text-white">
        <strong>Study Room Details</strong>
    </div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.RoomName)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.RoomName)
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.IsPrivate)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.IsPrivate)
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.AccessCode)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.AccessCode)
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.CreatedAt)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.CreatedAt)
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.CreatedByNavigation)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.CreatedByNavigation.UserId)
            </dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" class="mt-4">
    <input type="hidden" asp-for="RoomId" />
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-danger">
            🗑️ Confirm Delete
        </button>
        <a asp-action="Index" class="btn btn-secondary">
            ← Back to List
        </a>
    </div>
</form>
