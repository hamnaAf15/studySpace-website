@model studySpaceWebApp.Models.StudyRoom

@{
    ViewData["Title"] = "Details";
}

<h1 class="mb-4">Study Room Details</h1>

<div class="card shadow-sm">
    <div class="card-header bg-info text-white">
        <strong>Room Information</strong>
    </div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.RoomName)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.RoomName)
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.IsPrivate)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.IsPrivate)
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.AccessCode)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.AccessCode)
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.CreatedAt)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.CreatedAt)
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.CreatedByNavigation)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.CreatedByNavigation.UserId)
            </dd>
        </dl>
    </div>
</div>

<div class="mt-4 d-flex gap-2">
    <a asp-action="Edit" asp-route-id="@Model?.RoomId" class="btn btn-primary">
        ✏️ Edit
    </a>
    <a asp-action="Index" class="btn btn-secondary">
        ← Back to List
    </a>
</div>
