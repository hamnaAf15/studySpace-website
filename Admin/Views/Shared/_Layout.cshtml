@{
    Layout = null;
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
   
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StudySpace Admin</title>

    <link rel="stylesheet" href="/Admins/css/bootstrap.css" />
    <link rel="stylesheet" href="/Admins/vendors/iconly/bold.css" />
    <link rel="stylesheet" href="/Admins/vendors/perfect-scrollbar/perfect-scrollbar.css" />
    <link rel="stylesheet" href="/Admins/vendors/bootstrap-icons/bootstrap-icons.css" />
    <link rel="stylesheet" href="/Admins/css/app.css" />
    <link rel="shortcut icon" href="/Admins/images/favicon.svg" type="image/x-icon" />
</head>
<body>
    <div id="app">
        <!-- SIDEBAR -->
        <div id="sidebar" class="active">
            <div class="sidebar-wrapper active">
                <div class="sidebar-header d-flex justify-content-between">
                    <a href="@Url.Action("Index", "Dashboard")" class="logo">
                        <img src="/Admins/images/NewFolder/logo1.png" alt="StudySpace Logo" />
                    </a>
                    <a href="#" class="sidebar-hide d-xl-none d-block">
                        <i class="bi bi-x bi-middle"></i>
                    </a>
                </div>

                <div class="sidebar-menu">
                    <ul class="menu">

                        <li class="sidebar-item @(currentController == "AdminDashboard" ? "active" : "")">
                            <a href="@Url.Action("Index", "AdminDashboard")" class="sidebar-link">
                                <i class="bi bi-speedometer2"></i><span>Dashboard</span>
                            </a>
                        </li>


                        <!-- Existing Links -->
                        <li class="sidebar-item @(currentController == "Users" ? "active" : "")">
                            <a href="@Url.Action("Index", "Users")" class="sidebar-link">
                                <i class="bi bi-people"></i><span>Users</span>
                            </a>
                        </li>

                        <li class="sidebar-item @(currentController == "StudyRooms" ? "active" : "")">
                            <a href="@Url.Action("Index", "StudyRooms")" class="sidebar-link">
                                <i class="bi bi-house-door"></i><span>Study Rooms</span>
                            </a>
                        </li>

                        <li class="sidebar-item @(currentController == "RoomMembers" ? "active" : "")">
                            <a href="@Url.Action("Index", "RoomMembers")" class="sidebar-link">
                                <i class="bi bi-person-lines-fill"></i><span>Room Members</span>
                            </a>
                        </li>

                        <li class="sidebar-item @(currentController == "Resources" ? "active" : "")">
                            <a href="@Url.Action("Index", "Resources")" class="sidebar-link">
                                <i class="bi bi-folder2-open"></i><span>Resources</span>
                            </a>
                        </li>

                        <li class="sidebar-item @(currentController == "AuthProviders" ? "active" : "")">
                            <a href="@Url.Action("Index", "AuthProviders")" class="sidebar-link">
                                <i class="bi bi-shield-lock"></i><span>Auth Providers</span>
                            </a>
                        </li>

                        <!-- Logout -->
                        <li class="sidebar-item mt-3">
                            <form asp-controller="Login" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="btn btn-danger w-100">
                                    <i class="bi bi-box-arrow-right"></i> Logout
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>

                <button class="sidebar-toggler btn x"><i data-feather="x"></i></button>
            </div>
        </div>

        <!-- MAIN CONTENT -->
        <div id="main">
            <header class="mb-3 d-flex justify-content-between align-items-center px-4 pt-3">
                <a href="#" class="burger-btn d-block d-xl-none">
                    <i class="bi bi-justify fs-3"></i>
                </a>
             
            </header>

            <div class="page-content px-4">
                @RenderBody()
            </div>

            <footer class="mt-4">
                <div class="footer clearfix mb-0 text-muted px-4">
                    <div class="float-start">
                        <p>&copy; 2025 StudySpace</p>
                    </div>
                    <div class="float-end">
                        <p>Crafted with ❤️ by StudySpace Team</p>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <script src="/Admins/vendors/perfect-scrollbar/perfect-scrollbar.min.js"></script>
    <script src="/Admins/js/bootstrap.bundle.min.js"></script>
    <script src="/Admins/js/pages/dashboard.js"></script>
    <script src="/Admins/js/main.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
