@model IEnumerable<studySpaceWebApp.Models.RoomMember>

@{
    ViewData["Title"] = "Room Members";
}

<h1 class="mb-4">Room Members</h1>

<table class="table table-bordered table-striped table-hover shadow-sm">
    <thead class="table-dark">
        <tr>
            <th>@Html.DisplayNameFor(model => model.FirstOrDefault().JoinedAt)</th>
            <th>@Html.DisplayNameFor(model => model.FirstOrDefault().Room)</th>
            <th>@Html.DisplayNameFor(model => model.FirstOrDefault().User)</th>
            <th class="text-center">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.JoinedAt)</td>
                <td>@(item.Room?.RoomName ?? $"Room #{item.RoomId}")</td>
                <td>@(item.User?.FullName ?? $"User #{item.UserId}")</td>
                <td class="text-center">
                    <div class="btn-group" role="group">
                        <a asp-action="Edit" asp-route-id="@item.MemberId" class="btn btn-sm btn-primary">✏️ Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.MemberId" class="btn btn-sm btn-danger">🗑️ Delete</a>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
